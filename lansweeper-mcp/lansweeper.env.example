# On-prem Lansweeper Classic connection (user/password auth).
# Source-project template only. Initialize-LansweeperSharedKey.ps1 copies approved
# values into the DPAPI-protected C:\caddy-gateway\secrets\lansweeper-gateway.xml;
# never place real values in this folder.
LANSWEEPER_URL=https://ls.healthbc.org
# Bare AD username only. The console fixes the domain itself (Domain: HEALTHBC);
# a "HEALTHBC\user" prefix is stripped automatically but is not needed.
LANSWEEPER_USERNAME=your.user
LANSWEEPER_PASSWORD=
# Optional: comma-separated list of asset/report paths the discovery tool should try.
# LANSWEEPER_ASSET_PATHS=/Assets.aspx,/reporting.aspx
# ls.healthbc.org presents an internal CA certificate, so this must be "true".
LANSWEEPER_ALLOW_INVALID_CERT=true
